# Frontend API and Dev Server Configuration
# Base URL for frontend API requests (leave empty to use Vite dev proxy '/api')
VITE_API_BASE_URL=

# Backend target URL for Vite dev proxy
VITE_DEV_BACKEND_URL=http://localhost:5000

# Dev server origin header forwarded in proxy requests
VITE_DEV_ORIGIN=http://localhost:5173

# Frontend dev server port and host binding
VITE_PORT=5173
VITE_HOST=true
